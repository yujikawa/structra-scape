{
  "name": "structra-scape",
  "version": "0.1.0",
  "description": "Business processes and the meaning of business terms, written as YAML by AI agents (Claude Code, Codex) and reviewed in a self-contained HTML viewer",
  "keywords": [
    "ontology",
    "glossary",
    "business-process",
    "data-catalog",
    "yaml",
    "claude-code",
    "codex",
    "ai-agent"
  ],
  "homepage": "https://github.com/yujikawa/structra-scape#readme",
  "bugs": {
    "url": "https://github.com/yujikawa/structra-scape/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yujikawa/structra-scape.git"
  },
  "license": "MIT",
  "author": "yujikawa",
  "type": "module",
  "bin": {
    "strscape": "src/index.js"
  },
  "files": [
    "src",
    "samples",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/ontology.test.js tests/mutate.test.js tests/skills.test.js tests/files.test.js",
    "test:browser": "node --test tests/browser.test.js",
    "dev": "node src/index.js dev samples/",
    "build": "node src/index.js build samples/ --output dist"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "cytoscape": "^3.33.1",
    "express": "^4.21.2",
    "js-yaml": "^4.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "playwright-core": "~1.58.0"
  }
}
